   11) 🐲 ด่านโบนัส BOSS BATTLE
===================================================================== */
const BOSS={hp:4,max:4,combo:0,idx:0,seq:[]};
function bossHtmlUpdate(){
  const pct=Math.max(0,BOSS.hp/BOSS.max*100);
  document.getElementById('bossHp').style.width=pct+'%';
  document.getElementById('bossHpTxt').textContent=`พลังชีวิตบอส ${Math.max(0,BOSS.hp)} / ${BOSS.max}`;
  document.getElementById('bossCombo').innerHTML=BOSS.combo>1?`🔥 COMBO ×${BOSS.combo} — คะแนนทวีคูณ!`:'ตอบถูกติดต่อกันเพื่อเพิ่ม COMBO';
}
function bossReact(ok){
  const e=document.getElementById('bossEmo'),box=document.getElementById('qBox');
  if(ok){
    BOSS.hp--;SFX.slash();if(BOSS.combo>1)setTimeout(()=>SFX.combo(BOSS.combo),260);
    e.classList.remove('hit');void e.offsetWidth;e.classList.add('hit');
  }else{
    SFX.roar();e.classList.remove('atk');void e.offsetWidth;e.classList.add('atk');
    box.classList.remove('flashno');void box.offsetWidth;box.classList.add('flashno');
  }
  bossHtmlUpdate();
}
function startBoss(){
  const T=THEMES[G.level-1];
  BOSS.hp=BOSS.max=4;BOSS.combo=0;BOSS.idx=0;
  BOSS.seq=[ 'listen','speak', rnd(['form','sentence']), rnd(['write','order']) ];
  G.state='bonus';SFX.roar();
  document.getElementById('bossEmo').textContent=T.boss;
  document.getElementById('bossName').textContent=T.bossName;
  bossHtmlUpdate();
  banner(`${T.boss} <b>BOSS BATTLE!</b><br><span style="font-size:.58em">${T.bossName} ปรากฏตัว!<br>ตอบให้ถูก 4 ข้อ ครบ 4 ทักษะ เพื่อปราบบอส<br>⏱️ ข้อละ 60 วินาที · คะแนน ×3 · มีระบบ COMBO</span>`,2600);
  setTimeout(nextBoss,2650);
}
function nextBoss(){
  if(BOSS.idx>=BOSS.seq.length||BOSS.hp<=0){finishBoss();return}
  askQuestion(BOSS.seq[BOSS.idx++],true,()=>{
    document.getElementById('mQ').classList.remove('on');ordSel=[];
    setTimeout(nextBoss,300);
  });
}
function finishBoss(){
  const T=THEMES[G.level-1];
  document.getElementById('qBox').classList.remove('boss');
  document.getElementById('bossBox').style.display='none';
  const win=BOSS.hp<=0;
  if(win){G.score+=1000;SFX.victory()}else{G.score+=200;SFX.gameover()}
  updHUD();
  banner(win
   ? `🏆 ปราบ ${T.bossName} สำเร็จ!<br><span style="font-size:.55em">โบนัสปราบบอส +1,000 คะแนน</span>`
   : `💨 ${T.bossName} หนีไปได้!<br><span style="font-size:.55em">ได้คะแนนปลอบใจ +200 · ครั้งหน้าสู้ใหม่นะ</span>`,2200);
  setTimeout(finishLevel,2250);
}
function finishLevel(){
  SFX.levelup();G.score+=500;updHUD();
  const cleared=G.level;
  if(cleared<5){
    G.unlocked=Math.max(G.unlocked,cleared+1);
    G.level=cleared+1;G.state='idle';
    saveGame(true);netPush(true);
    banner(`✅ ผ่านด่าน ${cleared} แล้ว!<br><span style="font-size:.55em">โบนัสผ่านด่าน +500 คะแนน<br>💾 บันทึกความคืบหน้าอัตโนมัติ</span>`,2000);
    setTimeout(()=>{
      G.playing=false;renderMenu();show('scMenu');startMusic('menu');
      toast(`🎉 ปลดล็อกด่าน ${G.level}: ${THEMES[G.level-1].name} ${THEMES[G.level-1].em}`);
    },2050);
  }else setTimeout(()=>endGame(true),900);
}
function quitGame(){
  if(!confirm('ออกจากเกมและบันทึกผลการเรียนรู้?'))return;
  document.getElementById('mP').classList.remove('on');endGame(false);
}

