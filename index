const AU={ctx:null,master:null,mg:null,sg:null,music:true,sfx:true,timer:null,step:0,next:0,cur:null};
function initAudio(){
  if(AU.ctx)return;
  try{
    AU.ctx=new (window.AudioContext||window.webkitAudioContext)();
    AU.master=AU.ctx.createGain();AU.master.gain.value=.9;AU.master.connect(AU.ctx.destination);
    AU.mg=AU.ctx.createGain();AU.mg.gain.value=.22;AU.mg.connect(AU.master);
    AU.sg=AU.ctx.createGain();AU.sg.gain.value=.55;AU.sg.connect(AU.master);
  }catch(e){}
}
let ttsWarm=false;
function unlockAudio(){
  initAudio();
  if(AU.ctx&&AU.ctx.state!=='running'){try{AU.ctx.resume()}catch(e){}}
  if(AU.ctx&&!AU.unl){
    try{const b=AU.ctx.createBuffer(1,1,22050),sr=AU.ctx.createBufferSource();sr.buffer=b;sr.connect(AU.ctx.destination);sr.start(0);AU.unl=true}catch(e){}
  }
  if(!ttsWarm&&'speechSynthesis' in window){
    try{const u=new SpeechSynthesisUtterance(' ');u.volume=0;speechSynthesis.speak(u);ttsWarm=true}catch(e){}
  }
}
