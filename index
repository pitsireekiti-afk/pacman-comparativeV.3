function rowsAll(db){
  const H=['วันที่','ชื่อ-นามสกุล','ชั้น','เลขที่','โหมด','ห้องแข่ง','ด่านสูงสุด','คะแนนรวม','จำนวนข้อ','ตอบถูก','ร้อยละ','ระดับผลการเรียนรู้',
   'ฟัง(%)','พูด(%)','อ่าน(%)','เขียน(%)','เติม-er(%)','ซ้ำตัวสะกด(%)','y→i(%)','ลงท้าย e(%)','ใช้more(%)','เวลาเล่น(นาที)'];
  const p=(o,k)=>{const s=o&&o[k];return s&&s.t?Math.round(s.c/s.t*100):''};
  return[H,...db.map(r=>[r.date,r.name,r.cls,r.no,r.mode==='live'?'แข่งสด':'ฝึกฝน',r.room||'',r.level,r.score,r.total,r.correct,r.pct,grade(r.pct),
   p(r.skill,'listening'),p(r.skill,'speaking'),p(r.skill,'reading'),p(r.skill,'writing'),
   p(r.gram,'er'),p(r.gram,'double'),p(r.gram,'y'),p(r.gram,'e'),p(r.gram,'more'),r.minutes])];
}
function dl(name,content,mime){
  const b=new Blob([content],{type:mime}),u=URL.createObjectURL(b);
  const a=document.createElement('a');a.href=u;a.download=name;document.body.appendChild(a);a.click();
  document.body.removeChild(a);URL.revokeObjectURL(u);toast('📤 ดาวน์โหลดไฟล์แล้ว');
}
function exportCSV(){
  const d=rowsAll(loadDB()).map(r=>r.map(c=>`"${String(c).replace(/"/g,'""')}"`).join(',')).join('\r\n');
  dl(`คะแนน_ComparativeQuest_${new Date().toISOString().slice(0,10)}.csv`,'\uFEFF'+d,'text/csv;charset=utf-8');
}
function exportTSV(){
  const d=rowsAll(loadDB()).map(r=>r.join('\t')).join('\n');
  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(d).then(()=>alert('✅ คัดลอกแล้ว! เปิด Google Sheets แล้วกด Ctrl+V เพื่อวาง'))
     .catch(()=>prompt('คัดลอกข้อความด้านล่าง:',d));
  }else prompt('คัดลอกข้อความด้านล่าง:',d);
}
function exportJSON(){dl('ComparativeQuest_backup.json',JSON.stringify(loadDB(),null,2),'application/json')}
function exportOne(){
  const r=window.__rec;if(!r)return;
  const H=['ข้อที่','ด่าน','ทักษะ','ด่านบอส','คำศัพท์','หลักการ','โจทย์','คำตอบนักเรียน','เฉลย','ผล','เวลา(วินาที)','คะแนน'];
  const rs=r.detail.map((d,i)=>[i+1,d.lv,TAGTXT[d.skill][0],d.bonus?'ใช่':'ไม่',d.word,d.rule,d.question,d.studentAns,d.correctAns,d.correct?'ถูก':'ผิด',d.time,d.pts]);
  const head=[['ชื่อ',r.name],['ชั้น',r.cls],['เลขที่',r.no],['วันที่',r.date],['คะแนนรวม',r.score],['ความแม่นยำ',r.pct+'%'],['ระดับ',grade(r.pct)],[]];
  const csv=[...head,H,...rs].map(x=>x.map(c=>`"${String(c).replace(/"/g,'""')}"`).join(',')).join('\r\n');
  dl(`ผลคะแนน_${r.name}_${r.cls}.csv`,'\uFEFF'+csv,'text/csv;charset=utf-8');
}
function doPrint(html){document.getElementById('printArea').innerHTML=html;setTimeout(()=>window.print(),150)}
function printStudent(){
  const r=window.__rec;if(!r)return;
  const sk={listening:'การฟัง',speaking:'การพูด',reading:'การอ่าน',writing:'การเขียน'};
  const gl={er:'เติม -er',double:'ซ้ำตัวสะกด + -er',y:'y → i + -er',e:'ลงท้าย e เติม -r',more:'ใช้ more นำหน้า'};
  doPrint(`<h2 style="text-align:center">รายงานผลการเรียนรู้ — Comparative Quest</h2>
   <p style="text-align:center">เรื่อง การเปรียบเทียบขั้นกว่า (-er / more) · ภาษาอังกฤษ ชั้นประถมศึกษาปีที่ 5</p>
   <p><b>ชื่อ:</b> ${esc(r.name)} &nbsp; <b>ชั้น:</b> ${esc(r.cls)} &nbsp; <b>เลขที่:</b> ${esc(r.no)} &nbsp; <b>วันที่:</b> ${r.date}</p>
   <p><b>คะแนนรวม:</b> ${r.score} &nbsp; <b>ตอบถูก:</b> ${r.correct}/${r.total} (${r.pct}%) &nbsp; <b>ด่านสูงสุด:</b> ${r.level} &nbsp; <b>ระดับผลการเรียนรู้:</b> ${grade(r.pct)}</p>
   <h3>ผลประเมินรายทักษะ</h3><table><tr><th>ทักษะ</th><th>ถูก/ข้อ</th><th>ร้อยละ</th></tr>
   ${Object.keys(sk).map(k=>{const s=r.skill[k];return `<tr><td>${sk[k]}</td><td>${s.c}/${s.t}</td><td>${s.t?Math.round(s.c/s.t*100)+'%':'-'}</td></tr>`}).join('')}</table>
   <h3>ผลประเมินรายหลักไวยากรณ์</h3><table><tr><th>หลักการ</th><th>ถูก/ข้อ</th><th>ร้อยละ</th></tr>
   ${Object.keys(gl).map(k=>{const s=r.gram[k]||{c:0,t:0};return `<tr><td>${gl[k]}</td><td>${s.c}/${s.t}</td><td>${s.t?Math.round(s.c/s.t*100)+'%':'-'}</td></tr>`}).join('')}</table>
   <h3>รายละเอียดรายข้อ</h3><table><tr><th>#</th><th>ด่าน</th><th>ทักษะ</th><th>คำศัพท์</th><th>คำตอบนักเรียน</th><th>เฉลย</th><th>ผล</th></tr>
   ${r.detail.map((d,i)=>`<tr><td>${i+1}</td><td>${d.lv}</td><td>${TAGTXT[d.skill][0]}</td><td>${d.word}</td><td>${esc(d.studentAns)}</td><td>${esc(d.correctAns)}</td><td>${d.correct?'ถูก':'ผิด'}</td></tr>`).join('')}</table>
   <p style="margin-top:26px">ลงชื่อ ....................................... ครูผู้สอน &nbsp;&nbsp;&nbsp; ลงชื่อ ....................................... ผู้ปกครอง</p>`);
}
function printClass(){
  const db=loadDB(),R=rowsAll(db);
  doPrint(`<h2 style="text-align:center">รายงานสรุปผลชั้นเรียน — Comparative Quest</h2>
   <p style="text-align:center">พิมพ์เมื่อ ${new Date().toLocaleString('th-TH')} · จำนวน ${db.length} รายการ</p>
   <table><tr>${R[0].map(h=>`<th>${h}</th>`).join('')}</tr>
   ${R.slice(1).map(r=>`<tr>${r.map(c=>`<td>${esc(c)}</td>`).join('')}</tr>`).join('')}</table>
   <p style="margin-top:26px">ลงชื่อ ....................................... ครูผู้สอน</p>`);
}
