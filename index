}
function backFromLB(){
  if(prevScreen==='scGame'&&G.playing)backToGame();
  else if(prevScreen==='scResult')show('scResult');
  else if(prevScreen==='scTeacher')show('scTeacher');
  else if(G.student){renderMenu();show('scMenu');startMusic('menu')}
  else show('scLogin');
