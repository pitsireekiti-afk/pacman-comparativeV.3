/* =====================================================================
   10) ระบบคำถาม 4 ทักษะ
===================================================================== */
const QTIME=120,BTIME=60;
function nextWord(){if(!G.usedW.length)G.usedW=shuffle(WORDS.map((_,i)=>i));return WORDS[G.usedW.pop()]}
function nextSent(){
  if(!G.usedS.length)G.usedS=shuffle(SENTS.map((_,i)=>i));
  const s=SENTS[G.usedS.pop()];
  return{s,w:WORDS.find(x=>x.w===s.a)};
}
function makeChoices(W){
  const b=W.w,set=new Set([W.c]);
  if(W.rule==='more'){set.add(b+'er');set.add('more '+b+'er');set.add(b+'est')}
  else if(W.rule==='double'){set.add('more '+b);set.add(b+'er');set.add(b+'est')}
  else if(W.rule==='y'){set.add('more '+b);set.add(b+'er');set.add(b.slice(0,-1)+'iest')}
  else if(W.rule==='e'){set.add('more '+b);set.add(b+'er');set.add(b+'st')}
  else{set.add('more '+b);set.add(b+'est');set.add(b+b.slice(-1)+'er')}
  let arr=[...set];
  if(arr.length>4)arr=arr.filter(x=>x!==W.c).slice(0,3).concat(W.c);
  return shuffle(arr);
}
let QT=null,QSecs=0,QCur=null,QAnswered=false,QLimit=QTIME;
function askQuestion(type,isBonus,onDone){
  G.state=isBonus?'bonus':'question';QAnswered=false;stopMusic();
  if(isBonus)startMusic('boss');
  const q=buildQ(type);QCur=q;QCur.onDone=onDone;QCur.bonus=!!isBonus;
  const [txt,cls]=TAGTXT[SKILL[type]];
  document.getElementById('qTag').textContent=txt;
  document.getElementById('qTag').className='qtag '+cls;
  document.getElementById('qNo').textContent=(isBonus?'🐲 บอส · คะแนน ×3 · ':'')+`ข้อที่ ${++G.qIndex} · ด่าน ${G.level}`;
  document.getElementById('qBody').innerHTML=q.html;
  document.getElementById('qFb').className='fb';
  document.getElementById('qFb').innerHTML='';
  document.getElementById('qNext').style.display='none';
  document.getElementById('qBox').classList.toggle('boss',!!isBonus);
  document.getElementById('bossBox').style.display=isBonus?'block':'none';
  document.getElementById('mQ').classList.add('on');
  if(q.after)q.after();
  QLimit=isBonus?BTIME:QTIME;QSecs=QLimit;tickQ();QT=setInterval(tickQ,1000);
}
function tickQ(){
  const m=String(Math.floor(QSecs/60)).padStart(2,'0'),s=String(QSecs%60).padStart(2,'0');
  document.getElementById('qClock').textContent=m+':'+s;
  document.getElementById('timerFill').style.width=(QSecs/QLimit*100)+'%';
  document.getElementById('timerFill').style.background=QSecs<20?'linear-gradient(90deg,#ff6b6b,#ffa94d)':'linear-gradient(90deg,#6bcB77,#ffd93d)';
  if(QSecs<=10&&QSecs>0)SFX.tick();
  if(QSecs<=0){clearInterval(QT);if(!QAnswered)submit(null)}
  QSecs--;
}
function buildQ(type){
  if(type==='form'){
    const W=nextWord(),ch=makeChoices(W);
    return{type,W,ans:W.c,
      html:`<div class="qth">เลือกรูปขั้นกว่า (comparative) ที่ถูกต้อง</div>
       <div class="qtext">${W.w} <span style="color:#9fb3d4;font-size:.75em">(${W.th})</span> → ?</div>
       <div class="center" style="margin-bottom:8px"><button class="btn ghost small" onclick="speak('${W.w}')">🔊 ฟังคำอ่าน</button></div>
       <div class="choices">${ch.map(c=>`<button class="choice" onclick="submit(this.textContent,this)">${c}</button>`).join('')}</div>`};
  }
  if(type==='sentence'){
    const {s,w:W}=nextSent(),ch=makeChoices(W);
    return{type,W,ans:W.c,sent:s,
      html:`<div class="qth">เติมคำในช่องว่างให้ถูกต้อง</div>
       <div class="qtext">${s.s.replace('___','<span style="color:#ffd93d">______</span>')}</div>
       <div class="qth">💡 คำที่กำหนดให้: <b style="color:#8fd3ff">${W.w}</b> (${W.th})<br>${s.th}</div>
       <div class="choices">${ch.map(c=>`<button class="choice" onclick="submit(this.textContent,this)">${c}</button>`).join('')}</div>`};
  }
  if(type==='listen'){
    const {s,w:W}=nextSent(),full=s.s.replace('___',W.c),ch=makeChoices(W);
    return{type,W,ans:W.c,sent:s,
      html:`<div class="qth">ฟังประโยคแล้วเลือกคำที่ได้ยิน (กดฟังซ้ำได้)</div>
       <div class="center" style="font-size:48px;margin:4px">🎧</div>
       <div class="center"><button class="btn blue" onclick="speak(this.dataset.t)" data-t="${full}">▶️ ฟังประโยค</button>
       <button class="btn ghost small" onclick="speak(this.dataset.t,0.6)" data-t="${full}">🐢 ฟังช้า ๆ</button></div>
       <div class="choices" style="margin-top:13px">${ch.map(c=>`<button class="choice" onclick="submit(this.textContent,this)">${c}</button>`).join('')}</div>`,
      after:()=>setTimeout(()=>speak(full),450)};
  }
  if(type==='write'){
    const W=nextWord();
    return{type,W,ans:W.c,
      html:`<div class="qth">พิมพ์รูปขั้นกว่าให้ถูกต้อง (สะกดให้ครบ)</div>
       <div class="qtext">${W.w} <span style="color:#9fb3d4;font-size:.75em">(${W.th})</span></div>
       <div class="center" style="margin-bottom:8px"><button class="btn ghost small" onclick="speak('${W.w}')">🔊 ฟังคำอ่าน</button></div>
       <input id="wIn" placeholder="พิมพ์คำตอบที่นี่..." autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" enterkeyhint="done" onfocus="setTimeout(()=>this.scrollIntoView({block:'center',behavior:'smooth'}),300)"
        onkeydown="if(event.key==='Enter')submit(document.getElementById('wIn').value)">
       <div class="center" style="margin-top:12px"><button class="btn green" onclick="submit(document.getElementById('wIn').value)">✔️ ส่งคำตอบ</button></div>`,
      after:()=>setTimeout(()=>{const i=document.getElementById('wIn');if(i)i.focus()},130)};
  }
  if(type==='order'){
    const {s,w:W}=nextSent(),full=s.s.replace('___',W.c).replace(/\.$/,'');
    const words=full.split(' ');ordSel=[];
    return{type,W,ans:full+'.',sent:s,
      html:`<div class="qth">เรียงคำให้เป็นประโยคที่ถูกต้อง (แตะคำตามลำดับ)</div>
       <div id="orderLine"><span style="color:#5a7">แตะคำด้านล่าง...</span></div>
       <div class="wordbank" id="bank">${shuffle(words).map(w=>`<div class="wchip" onclick="pickWord(this)">${w}</div>`).join('')}</div>
       <div class="qth">💡 ความหมาย: ${s.th}</div>
       <div class="center"><button class="btn ghost small" onclick="resetOrder()">↩️ เริ่มใหม่</button>
       <button class="btn green" onclick="submit(orderText())">✔️ ส่งคำตอบ</button></div>`};
  }
  /* speak — AI ฟังและตรวจเสียงอ่านอัตโนมัติ */
  const {s,w:W}=nextSent(),full=s.s.replace('___',W.c);
  const sup=!!(window.SpeechRecognition||window.webkitSpeechRecognition);
  SPK.tries=0;SPK.busy=false;
  return{type,W,ans:full,speakTarget:full,
    html:`<div class="qth">อ่านออกเสียงประโยคนี้ให้ชัดเจน — AI จะฟังและตรวจให้</div>
     <div class="qtext">${full}</div><div class="qth">${s.th}</div>
     <div class="center"><button class="btn blue small" onclick="speak(this.dataset.t)" data-t="${full}">🔊 ฟังตัวอย่าง</button>
     <button class="btn ghost small" onclick="speak(this.dataset.t,0.6)" data-t="${full}">🐢 ฟังช้า ๆ</button></div>
     <div class="center">${sup
       ?`<button class="mic" id="micBtn" onclick="recSpeech()">🎤</button>
         <div class="qth" id="recTxt">แตะไมโครโฟนแล้วพูดทั้งประโยค (พูดได้ ${SPK.MAX} ครั้ง)</div>`
       :`<div class="qth" style="color:#ffd93d">⚠️ อุปกรณ์/เบราว์เซอร์นี้ไม่รองรับการตรวจเสียง<br>ให้ใช้ Chrome, Edge หรือ Safari — หรือกดข้ามข้อนี้ (ไม่ได้คะแนน)</div>
         <button class="btn ghost small" onclick="submit('__SKIP__')">⏭️ ข้ามข้อนี้</button>`}</div>`};
}
let ordSel=[];
function pickWord(el){SFX.click();el.classList.add('used');ordSel.push(el.textContent);renderOrder()}
function resetOrder(){ordSel=[];document.querySelectorAll('#bank .wchip').forEach(e=>e.classList.remove('used'));renderOrder()}
function renderOrder(){
  const l=document.getElementById('orderLine');if(!l)return;
  l.innerHTML=ordSel.length?ordSel.map(w=>`<span class="wchip" style="cursor:default">${w}</span>`).join(''):'<span style="color:#5a7">แตะคำด้านล่าง...</span>';
}
function orderText(){return ordSel.join(' ')+'.'}

const norm=s=>(s||'').toLowerCase().replace(/[^a-z\s]/g,'').replace(/\s+/g,' ').trim();

/* ===== ตรวจเสียงอ่านอัตโนมัติ ===== */
const SPK={tries:0,rec:null,busy:false,MAX:3};
const SKIPHTML='<br><button class="btn ghost small" onclick="submit(\'__SKIP__\')">⏭️ ข้ามข้อนี้ (ไม่ได้คะแนน)</button>';
function lev(a,b){const m=a.length,n=b.length,d=[];
  for(let i=0;i<=m;i++)d[i]=[i];for(let j=1;j<=n;j++)d[0][j]=j;
  for(let i=1;i<=m;i++)for(let j=1;j<=n;j++)
    d[i][j]=Math.min(d[i-1][j]+1,d[i][j-1]+1,d[i-1][j-1]+(a[i-1]===b[j-1]?0:1));
  return d[m][n]}
const wordsOf=s=>norm(s).split(' ').filter(Boolean);
const fuzzyHas=(list,w)=>list.some(x=>x===w||(w.length>=4&&x.length>=4&&lev(x,w)<=1));
const exactHas=(list,w)=>list.some(x=>x===w||(w.length>=7&&lev(x,w)<=1));
function scoreSpeech(heard,target,W){
  const tw=wordsOf(target),hw=wordsOf(heard);
  const hit=tw.filter(w=>fuzzyHas(hw,w)).length;
  const ratio=hit/Math.max(1,tw.length);
  const keyOk=wordsOf(W.c).every(w=>exactHas(hw,w));   // คำเปรียบเทียบต้องถูกเป๊ะ
  return{ratio,keyOk,ok:ratio>=.75&&keyOk};
}
function stopRec(){try{if(SPK.rec)SPK.rec.abort()}catch(e){}SPK.rec=null;SPK.busy=false}
function recSpeech(){
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  if(!SR||QAnswered||SPK.busy)return;
  clearTimeout(speak._t);try{speechSynthesis.cancel()}catch(e){}            // กันไมค์จับเสียงตัวอย่าง
  const btn=document.getElementById('micBtn'),tx=document.getElementById('recTxt');
  const r=new SR();r.lang='en-US';r.interimResults=false;r.maxAlternatives=5;r.continuous=false;
  SPK.rec=r;SPK.busy=true;let got=false,failed=false;
  btn.classList.add('rec');tx.innerHTML='🔴 กำลังฟัง... พูดได้เลย!';
  r.onresult=e=>{
    got=true;
    const alts=[...e.results[0]].map(a=>a.transcript);
    let best=null;
    alts.forEach(t=>{const s=scoreSpeech(t,QCur.speakTarget,QCur.W);
      if(!best||(s.ok&&!best.s.ok)||(s.ok===best.s.ok&&s.ratio>best.s.ratio))best={t,s}});
    SPK.busy=false;btn.classList.remove('rec');
    if(best.s.ok){tx.innerHTML='✅ AI ได้ยินว่า: "'+esc(best.t)+'"';submit(best.t);return}
    SPK.tries++;
    if(SPK.tries>=SPK.MAX){submit(best.t);return}
    SFX.wrong();
    tx.innerHTML='🤔 AI ได้ยินว่า: "<b>'+esc(best.t)+'</b>"<br>ยังไม่ตรง ลองฟังตัวอย่างแล้วพูดอีกครั้งนะ (เหลือ '+(SPK.MAX-SPK.tries)+' ครั้ง)';
  };
  r.onerror=e=>{
    failed=true;SPK.busy=false;btn.classList.remove('rec');
    if(e.error==='not-allowed'||e.error==='service-not-allowed'){
      tx.innerHTML='🚫 ยังใช้ไมโครโฟนไม่ได้ — กดอนุญาตไมค์ให้เบราว์เซอร์<br>และเปิด Siri / การป้อนข้อความด้วยเสียง (Dictation) ในตั้งค่าเครื่อง แล้วแตะ 🎤 ใหม่'+SKIPHTML;
    }else if(e.error==='no-speech'){tx.textContent='🔇 ไม่ได้ยินเสียง ลองพูดให้ดังขึ้นแล้วแตะ 🎤 อีกครั้ง'}
    else if(e.error==='network'){tx.innerHTML='🌐 ต้องต่ออินเทอร์เน็ตเพื่อตรวจเสียง ลองใหม่อีกครั้ง'+SKIPHTML}
    else if(e.error!=='aborted'){tx.textContent='❌ ตรวจเสียงไม่สำเร็จ ลองแตะ 🎤 ใหม่'}
  };
  r.onend=()=>{btn.classList.remove('rec');SPK.busy=false;
    if(!got&&!failed&&!QAnswered)tx.textContent='🔇 ไม่ได้ยินเสียง ลองแตะ 🎤 อีกครั้ง'};
  try{r.start()}catch(e){SPK.busy=false;btn.classList.remove('rec')}
}

function submit(val,el){
  if(QAnswered)return;QAnswered=true;clearInterval(QT);stopRec();
  const q=QCur;let ok=false,note='',skipped=false;
  if(val===null){note='⏰ หมดเวลา'}
  else if(val==='__SKIP__'){skipped=true;note='อุปกรณ์ไม่รองรับการตรวจเสียง — ข้อนี้ไม่นับคะแนน'}
  else if(q.type==='speak'){
    const sc=scoreSpeech(val,q.speakTarget,q.W);ok=sc.ok;
    note=`AI ได้ยินว่า: "${esc(val)}" · ออกเสียงตรงประมาณ ${Math.round(sc.ratio*100)}%`+
         (!ok&&!sc.keyOk?` · คำสำคัญคือ "${q.W.c}"`:'');
  }else ok=norm(val)===norm(q.ans);

  let pts=0;
  if(ok){
    const base=['write','order','speak'].includes(q.type)?260:200;
    if(q.bonus){BOSS.combo++;pts=Math.round(base*3*(1+(BOSS.combo-1)*.5))}
    else pts=base;
  }else if(q.bonus&&!skipped)BOSS.combo=0;
  G.score+=pts;
  if(!skipped)G.log.push({lv:G.level,type:q.type,skill:SKILL[q.type],bonus:!!q.bonus,word:q.W.w,rule:q.W.rule,
    question:q.sent?q.sent.s:q.W.w,correctAns:q.ans,studentAns:val===null?'(ไม่ตอบ)':val,
    correct:ok,time:QLimit-QSecs-1,pts});
  if(!skipped)(ok?SFX.correct():SFX.wrong());
  if(q.bonus&&!skipped)bossReact(ok);
  document.querySelectorAll('.choice').forEach(b=>{
    if(norm(b.textContent)===norm(q.ans))b.classList.add('ok');
    else if(el&&b===el)b.classList.add('no');
    b.onclick=null;
  });
  const fb=document.getElementById('qFb');
  fb.className='fb '+(ok?'ok':'no');
  fb.innerHTML=`<b style="font-size:17px">${skipped?'⚠️ ข้ามข้อนี้ (ไม่ได้คะแนน)':ok?'🎉 เก่งมาก! ตอบถูกต้อง':'❌ ยังไม่ถูก ลองทบทวนอีกครั้งนะ'}</b><br>
    ✅ คำตอบที่ถูกต้อง: <b style="color:#ffd93d">${q.ans}</b><br>
    📖 หลักการ: ${RULE_TIP[q.W.rule]}<br>
    🔤 <b>${q.W.w}</b> (${q.W.th}) → <b>${q.W.c}</b><br>
    ${note?'ℹ️ '+note+'<br>':''}⭐ ได้รับ ${pts} คะแนน${q.bonus&&ok&&BOSS.combo>1?` <span style="color:#ffd93d">(COMBO ×${BOSS.combo})</span>`:''}`;
  speak(q.W.c);
  document.getElementById('qNext').style.display='inline-block';
  updHUD();saveGame(true);netPush(true);
}
function closeQuestion(){
  document.getElementById('mQ').classList.remove('on');ordSel=[];
  if(QCur&&QCur.onDone)QCur.onDone();else afterOrb();
}
function afterOrb(){
  if(G.orbGot>=ORB_COUNT){startBoss();return}
  G.state='play';startMusic(G.level);lastT=performance.now();
}

