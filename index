/* =====================================================================
   8) เขาวงกต + เริ่มด่าน (ไอเท็มคำถาม 6 ชิ้นกระจายทั่วกระดาน)
===================================================================== */
const LEVEL_SEQ={
 1:['form','listen','sentence','write','speak','form'],
 2:['listen','form','write','sentence','speak','order'],
 3:['sentence','listen','order','speak','form','write'],
 4:['write','listen','speak','sentence','order','form'],
 5:['listen','speak','order','write','form','sentence']};
const SKILL={form:'reading',sentence:'reading',listen:'listening',write:'writing',order:'writing',speak:'speaking'};
const SKILL_EM={reading:'📖',listening:'🎧',writing:'✍️',speaking:'🎤'};
const TAGTXT={reading:['อ่าน READING','rea'],listening:['ฟัง LISTENING','lis'],writing:['เขียน WRITING','wri'],speaking:['พูด SPEAKING','spk']};

function genMaze(){
  const g=Array.from({length:ROWS},()=>Array(COLS).fill(1));
  const st=[[1,1]];g[1][1]=0;
  while(st.length){
    const [r,c]=st[st.length-1];
    const ds=shuffle([[0,2],[0,-2],[2,0],[-2,0]]);let mv=false;
    for(const [dr,dc] of ds){
      const nr=r+dr,nc=c+dc;
      if(nr>0&&nr<ROWS-1&&nc>0&&nc<COLS-1&&g[nr][nc]===1){
        g[r+dr/2][c+dc/2]=0;g[nr][nc]=0;st.push([nr,nc]);mv=true;break}
    }
    if(!mv)st.pop();
  }
  for(let r=1;r<ROWS-1;r++)for(let c=1;c<COLS-1;c++)
    if(g[r][c]===1&&(r%2===1||c%2===1)&&Math.random()<0.34)g[r][c]=0;
  return g;
}
const isWall=(r,c)=>r<0||c<0||r>=ROWS||c>=COLS||G.maze[r][c]===1;
const openCells=()=>{const a=[];for(let r=1;r<ROWS-1;r++)for(let c=1;c<COLS-1;c++)if(!isWall(r,c))a.push([r,c]);return a};
const dist=(a,b)=>Math.hypot(a[0]-b[0],a[1]-b[1]);

function spreadCells(cells,n,minD){
  const picked=[];
  const pool=shuffle(cells);
  let d=minD;
  while(picked.length<n&&d>0){
    for(const c of pool){
      if(picked.length>=n)break;
      if(picked.every(p=>dist(p,c)>=d)&&!picked.some(p=>p[0]===c[0]&&p[1]===c[1]))picked.push(c);
    }
    d-=1;
  }
  while(picked.length<n)picked.push(rnd(cells));
  return picked.slice(0,n);
}
function startLevel(lv,resumed){
  SFX.click();unlockAudio();
  G.level=lv;G.bestLevel=Math.max(G.bestLevel,lv);G.state='play';G.playing=true;keepAwake();
  if(!resumed)G.lives=3;
  G.maze=genMaze();
  const cells=openCells();
  G.pellets=Array.from({length:ROWS},()=>Array(COLS).fill(false));
  cells.forEach(([r,c])=>G.pellets[r][c]=true);
  const start=cells.reduce((b,x)=>((ROWS-x[0])+x[1]<(ROWS-b[0])+b[1]?x:b),cells[0]);
  G.player={x:(start[1]+.5)*TS,y:(start[0]+.5)*TS,dir:DIRS.R,next:null,speed:105,mouth:0,inv:0};
  const far=cells.filter(c=>dist(c,start)>2.5);
  const spots=spreadCells(far.length>=ORB_COUNT?far:cells,ORB_COUNT,5);
  const types=shuffle(LEVEL_SEQ[lv]);
  G.orbs=spots.map((s,i)=>({r:s[0],c:s[1],type:types[i]}));
  const rest=cells.filter(c=>!G.orbs.some(o=>o.r===c[0]&&o.c===c[1]));
  G.power=spreadCells(rest,4,4);
  const nG=Math.min(2+lv,6);
  const gs=spreadCells(cells.filter(c=>dist(c,start)>4),nG,3);
  G.ghosts=gs.map((c,i)=>({x:(c[1]+.5)*TS,y:(c[0]+.5)*TS,dir:rnd(Object.values(DIRS)),
    speed:64+lv*7,color:THEMES[lv-1].ghost[i%5],lastTile:''}));
  G.fright=0;G.orbGot=0;
  updHUD();show('scGame');startMusic(lv);saveGame(true);netPush(true);
  banner(`${THEMES[lv-1].em} ด่าน ${lv}<br><span style="font-size:.7em">${THEMES[lv-1].name}</span>
   <br><span style="font-size:.55em;color:#ffd93d">เก็บไอเท็มคำถาม ${ORB_COUNT} ชิ้น 🎧 🎤 📖 ✍️</span>`,1800);
  lastT=performance.now();requestAnimationFrame(loop);
}
