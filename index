  const gl={er:'เติม -er',double:'ซ้ำตัวสะกด + -er',y:'y → i + -er',e:'ลงท้าย e เติม -r',more:'ใช้ more นำหน้า'};
  document.getElementById('rsGram').innerHTML=Object.keys(gl).map(k=>{
    const s=rec.gram[k]||{c:0,t:0},p=s.t?Math.round(s.c/s.t*100):0;
    return `<div style="margin:9px 0"><b>${gl[k]}</b> — ${s.c}/${s.t} (${s.t?p+'%':'ยังไม่ได้ทำ'})<div class="bar"><i style="width:${p}%"></i></div></div>`}).join('');
  document.getElementById('rsLevel').innerHTML=THEMES.map(t=>{
    const s=rec.lvStat[t.id]||{c:0,t:0},p=s.t?Math.round(s.c/s.t*100):0;
    return `<div style="margin:8px 0"><b>${t.em} ด่าน ${t.id} ${t.name}</b> — ${s.c}/${s.t} (${s.t?p+'%':'-'})<div class="bar"><i style="width:${p}%"></i></div></div>`}).join('');
  const bad=[...new Set(rec.detail.filter(x=>!x.correct).map(x=>x.word))];
  document.getElementById('rsReview').innerHTML=bad.length
    ? bad.map(w=>{const W=WORDS.find(x=>x.w===w);return `• <b>${W.w}</b> (${W.th}) → <b style="color:#ffd93d">${W.c}</b> — ${RULE_TIP[W.rule]}`}).join('<br>')
    : '🎉 ไม่มีคำที่ต้องทบทวน เก่งมาก!';
