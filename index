function makeRecord(win){
  const L=G.log,tot=L.length,ok=L.filter(x=>x.correct).length;
  return{date:new Date().toLocaleString('th-TH'),ts:Date.now(),
   name:G.student.name,cls:G.student.cls,no:G.student.no,mode:G.mode,room:NET.room||'',
   level:G.bestLevel,score:G.score,total:tot,correct:ok,pct:tot?Math.round(ok/tot*100):0,
   skill:skillStat(L),gram:gramStat(L),lvStat:lvStat(L),detail:L,win:!!win,
   minutes:Math.max(1,Math.round((Date.now()-G.startTime)/60000))};
}
function skillStat(L){const o={listening:{c:0,t:0},speaking:{c:0,t:0},reading:{c:0,t:0},writing:{c:0,t:0}};
  L.forEach(x=>{o[x.skill].t++;if(x.correct)o[x.skill].c++});return o}
function gramStat(L){const o={};L.forEach(x=>{o[x.rule]=o[x.rule]||{c:0,t:0};o[x.rule].t++;if(x.correct)o[x.rule].c++});return o}
function lvStat(L){const o={};L.forEach(x=>{o[x.lv]=o[x.lv]||{c:0,t:0};o[x.lv].t++;if(x.correct)o[x.lv].c++});return o}
function grade(p){return p>=80?'ดีเยี่ยม (4)':p>=70?'ดี (3)':p>=60?'พอใช้ (2)':p>=50?'ผ่าน (1)':'ควรปรับปรุง (0)'}
const loadDB=()=>{try{return JSON.parse(localStorage.getItem('cqDB'))||[]}catch(e){return[]}};

function renderResult(rec,live){
