function lbData(cls){
  const db=loadDB(),map={};
  db.forEach(r=>{
    if(cls&&cls!=='ALL'&&r.cls!==cls)return;
    const k=r.name+'|'+r.cls+'|'+r.no;
    if(!map[k])map[k]={name:r.name,cls:r.cls,no:r.no,best:0,plays:0,lvl:0,totQ:0,totOk:0};
    const m=map[k];m.plays++;m.totQ+=r.total;m.totOk+=r.correct;
    if(r.score>m.best)m.best=r.score;
    if(r.level>m.lvl)m.lvl=r.level;
  });
  return Object.values(map).map(m=>({...m,acc:m.totQ?Math.round(m.totOk/m.totQ*100):0}))
   .sort((a,b)=>b.best-a.best||b.acc-a.acc);
}
function renderLB(){
  const db=loadDB();
  const classes=[...new Set(db.map(r=>r.cls))].sort();
  document.getElementById('lbChips').innerHTML=
    `<div class="chip ${lbFilter==='ALL'?'on':''}" onclick="lbFilter='ALL';renderLB()">🌏 ทุกห้อง</div>`+
    classes.map(c=>`<div class="chip ${lbFilter===c?'on':''}" onclick="lbFilter='${esc(c)}';renderLB()">${esc(c)}</div>`).join('');
  const list=lbData(lbFilter);
  const me=G.student?G.student.name+'|'+G.student.cls+'|'+G.student.no:'';
  const isMe=x=>(x.name+'|'+x.cls+'|'+x.no)===me;
  const top=list.slice(0,3);
  document.getElementById('lbPodium').innerHTML= top.length?`<div class="podium">
    ${top[1]?`<div class="pod p2"><div class="md">🥈</div><div class="nm">${esc(top[1].name)}</div><div class="sc">${top[1].best}</div></div>`:''}
    ${top[0]?`<div class="pod p1"><div class="md">🥇</div><div class="nm">${esc(top[0].name)}</div><div class="sc">${top[0].best}</div></div>`:''}
    ${top[2]?`<div class="pod p3"><div class="md">🥉</div><div class="nm">${esc(top[2].name)}</div><div class="sc">${top[2].best}</div></div>`:''}</div>`:'';
  document.getElementById('lbList').innerHTML= list.length? list.map((x,i)=>{
    const md=i===0?'🥇':i===1?'🥈':i===2?'🥉':(i+1);
    return `<div class="lbrow ${isMe(x)?'me':''}"><div class="rk">${md}</div>
      <div class="in"><div class="nm">${esc(x.name)} ${isMe(x)?'<span style="color:#ffd93d">(คุณ)</span>':''}</div>
      <div class="mt">${esc(x.cls)} เลขที่ ${esc(x.no)} · ด่านสูงสุด ${x.lvl} · แม่นยำ ${x.acc}% · เล่น ${x.plays} ครั้ง</div></div>
      <div class="sc">${x.best}</div></div>`}).join('')
   : '<p class="note center" style="padding:20px">ยังไม่มีข้อมูล — เล่นจบเกมแล้วคะแนนจะขึ้นกระดานผู้นำอัตโนมัติ</p>';
}

