const f=n=>261.63*Math.pow(2,n/12);
function tone(freq,dur,type,vol,dest,slide){
  if(!AU.ctx)return;
  const o=AU.ctx.createOscillator(),g=AU.ctx.createGain(),t=AU.ctx.currentTime;
  o.type=type||'square';o.frequency.setValueAtTime(freq,t);
  if(slide)o.frequency.exponentialRampToValueAtTime(Math.max(40,slide),t+dur);
  g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(vol||.3,t+.012);
  g.gain.exponentialRampToValueAtTime(.0008,t+dur);
  o.connect(g);g.connect(dest||AU.sg);o.start(t);o.stop(t+dur+.03);
}
function noise(dur,vol,dest){
  if(!AU.ctx)return;
  const n=Math.floor(AU.ctx.sampleRate*dur),b=AU.ctx.createBuffer(1,n,AU.ctx.sampleRate),d=b.getChannelData(0);
  for(let i=0;i<n;i++)d[i]=(Math.random()*2-1)*(1-i/n);
  const s=AU.ctx.createBufferSource();s.buffer=b;
  const g=AU.ctx.createGain();g.gain.value=vol||.15;
  s.connect(g);g.connect(dest||AU.sg);s.start();
}
