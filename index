  const b=document.getElementById('btnSfx');if(b)b.textContent='🔊 เสียง: '+(AU.sfx?'เปิด':'ปิด');
  toast(AU.sfx?'🔊 เปิดเสียงเอฟเฟกต์':'🔇 ปิดเสียงเอฟเฟกต์')}
function speak(text,rate){
  if(!('speechSynthesis' in window))return;
  try{
    speechSynthesis.cancel();
    clearTimeout(speak._t);
    speak._t=setTimeout(()=>{
      try{
        const u=new SpeechSynthesisUtterance(text);
        u.lang='en-US';u.rate=rate||.82;u.pitch=1;
        const vs=speechSynthesis.getVoices();
        const v=vs.find(x=>/en[-_]US/i.test(x.lang))||vs.find(x=>/^en/i.test(x.lang));
        if(v)u.voice=v;
        speechSynthesis.speak(u);
      }catch(e){}
    },70);
  }catch(e){}
}
