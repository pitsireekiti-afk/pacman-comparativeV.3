function startMusic(key){
  initAudio();if(!AU.ctx)return;stopMusic();
  AU.cur = key==='menu'?MENU_THEME : key==='boss'?BOSS_MUSIC : THEMES[key-1];
  if(!AU.music||!AU.cur)return;
  AU.step=0;AU.next=AU.ctx.currentTime+.08;
  AU.timer=setInterval(schedMusic,25);
}
function schedMusic(){
  if(!AU.ctx||!AU.cur)return;
  const T=AU.cur,spb=T.tempo;
  while(AU.next<AU.ctx.currentTime+.25){
    const n=T.mel[AU.step%T.mel.length];
    if(n!==null)tone(f(n+12),spb*.85,'square',.16,AU.mg);
    tone(f(T.bass[AU.step%T.bass.length]),spb*1.5,'triangle',.22,AU.mg);
    if(AU.step%2===0)noise(.045,.05,AU.mg);
    if(AU.step%8===0)noise(.11,.11,AU.mg);
    AU.next+=spb;AU.step++;
  }
}
function stopMusic(){if(AU.timer){clearInterval(AU.timer);AU.timer=null}}
function toggleMusic(){AU.music=!AU.music;
  const b=document.getElementById('btnMus');if(b)b.textContent='🎵 เพลง: '+(AU.music?'เปิด':'ปิด');
  toast(AU.music?'🎵 เปิดเพลง':'🔇 ปิดเพลง');
  if(!AU.music)stopMusic();else startMusic(G.playing?G.level:'menu')}
