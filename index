async function refreshLive(room){
  const data=await netList(room);
  const arr=Object.entries(data||{}).map(([k,v])=>({k,...v})).filter(x=>x&&x.name)
    .sort((a,b)=>(b.score||0)-(a.score||0));
  document.getElementById('liveState').innerHTML=
    `<span class="livedot ${netBase()&&!NET.online?'off':''}"></span><span style="font-size:14px;color:#9fb3d4">${netBase()?(NET.online?'ออนไลน์':'เชื่อมต่อไม่ได้'):'โหมดในเครื่อง'}</span>`;
  const now=Date.now();
  const active=arr.filter(x=>now-(x.t||0)<60000).length;
  const avg=arr.length?Math.round(arr.reduce((s,x)=>s+(x.score||0),0)/arr.length):0;
  const acc=(()=>{const t=arr.reduce((s,x)=>s+(x.total||0),0),c=arr.reduce((s,x)=>s+(x.correct||0),0);return t?Math.round(c/t*100):0})();
  document.getElementById('liveStat').innerHTML=`
    <div class="st"><b>${arr.length}</b><span>ผู้เข้าร่วม</span></div>
    <div class="st"><b>${active}</b><span>กำลังเล่นอยู่</span></div>
    <div class="st"><b>${avg}</b><span>คะแนนเฉลี่ย</span></div>
    <div class="st"><b>${acc}%</b><span>ความแม่นยำเฉลี่ย</span></div>
    <div class="st"><b>${arr.length?arr[0].score:0}</b><span>คะแนนสูงสุด</span></div>`;
  const top=arr.slice(0,3);
  document.getElementById('livePodium').innerHTML= top.length?`<div class="podium">
    ${top[1]?`<div class="pod p2"><div class="md">🥈</div><div class="nm">${esc(top[1].name)}</div><div class="sc">${top[1].score}</div></div>`:''}
    ${top[0]?`<div class="pod p1"><div class="md">🥇</div><div class="nm">${esc(top[0].name)}</div><div class="sc">${top[0].score}</div></div>`:''}
    ${top[2]?`<div class="pod p3"><div class="md">🥉</div><div class="nm">${esc(top[2].name)}</div><div class="sc">${top[2].score}</div></div>`:''}</div>`:'';
  document.getElementById('liveList').innerHTML= arr.length? arr.map((x,i)=>{
    const md=i===0?'🥇':i===1?'🥈':i===2?'🥉':(i+1);
    const on=now-(x.t||0)<60000;
    const stt=x.status==='boss'?'🐲 สู้บอส':x.status==='playing'?'🎮 กำลังเล่น':'⏸ พัก';
    return `<div class="lbrow ${x.k===NET.uid?'me':''}"><div class="rk">${md}</div>
      <div class="in"><div class="nm">${on?'<span class="livedot"></span>':''}${esc(x.name)}</div>
      <div class="mt">${esc(x.cls||'')} เลขที่ ${esc(x.no||'')} · ด่าน ${x.level||1} · 🔮 ${x.orb||0}/${ORB_COUNT} · ❤️ ${x.lives||0} · ✅ ${x.correct||0}/${x.total||0} · ${stt}</div></div>
      <div class="sc">${x.score||0}</div></div>`}).join('')
   : '<p class="note center" style="padding:24px">ยังไม่มีนักเรียนเข้าห้องนี้ — ให้นักเรียนเลือกโหมด <b>แข่งสด</b> แล้วใส่รหัสห้องเดียวกัน</p>';
}
async function clearRoom(){
  const room=document.getElementById('inRoom2').value.trim().toUpperCase();
