const NET={mode:'solo',room:'',uid:'',online:false,lastPush:0,pushTimer:null,pollTimer:null,bc:null};
try{NET.bc=('BroadcastChannel' in window)?new BroadcastChannel('cq-live'):null}catch(e){NET.bc=null}
function netBase(){return (localStorage.getItem('cqNet')||SERVER_URL||'').trim().replace(/\/+$/,'')}
const isGAS=u=>/script\.google\.com/.test(u);
function safeKey(s){return String(s).replace(/[.#$\[\]\/]/g,'_').replace(/\s+/g,'_')}
function makeUid(st){return safeKey(st.cls+'-'+st.no+'-'+st.name)}
function livePayload(){
  const ok=G.log.filter(l=>l.correct).length;
  return{name:G.student.name,cls:G.student.cls,no:G.student.no,score:G.score,level:G.level,
    correct:ok,total:G.log.length,lives:G.lives,orb:G.orbGot,
    status:G.playing?(G.state==='bonus'?'boss':'playing'):'idle',t:Date.now()};
}
function setOnline(v){NET.online=v}
function localRoomKey(r){return 'cqLive::'+r}
function localPush(room,uid,p){
  try{
    const k=localRoomKey(room),o=JSON.parse(localStorage.getItem(k)||'{}');
    o[uid]=p;localStorage.setItem(k,JSON.stringify(o));
    if(NET.bc)NET.bc.postMessage({room:room});
  }catch(e){}
}
async function netPush(force){
  if(NET.mode!=='live'||!G.student)return;
  const now=Date.now();
  if(!force&&now-NET.lastPush<1800)return;
  NET.lastPush=now;
  const p=livePayload(),base=netBase(),room=NET.room,uid=NET.uid;
  localPush(room,uid,p);
  if(!base)return;
  try{
    if(isGAS(base)){
      await fetch(base+'?action=push&room='+encodeURIComponent(room)+'&uid='+encodeURIComponent(uid)+'&data='+encodeURIComponent(JSON.stringify(p)));
    }else{
      await fetch(base+'/rooms/'+encodeURIComponent(room)+'/players/'+encodeURIComponent(uid)+'.json',
        {method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(p)});
    }
    setOnline(true);
  }catch(e){setOnline(false)}
}
async function netList(room){
  const base=netBase();
  if(base){
    try{
      let r;
      if(isGAS(base))r=await fetch(base+'?action=list&room='+encodeURIComponent(room));
      else r=await fetch(base+'/rooms/'+encodeURIComponent(room)+'/players.json');
      const j=await r.json();setOnline(true);
      if(j&&typeof j==='object')return j;
      return {};
    }catch(e){setOnline(false)}
  }
  try{return JSON.parse(localStorage.getItem(localRoomKey(room))||'{}')}catch(e){return{}}
}
async function netClear(room){
  const base=netBase();
  localStorage.removeItem(localRoomKey(room));
  if(NET.bc)NET.bc.postMessage({room});
  if(!base)return;
  try{
    if(isGAS(base))await fetch(base+'?action=clear&room='+encodeURIComponent(room));
    else await fetch(base+'/rooms/'+encodeURIComponent(room)+'.json',{method:'DELETE'});
  }catch(e){}
}
