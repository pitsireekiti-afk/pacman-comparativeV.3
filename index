/* =====================================================================
   9) Game Loop
===================================================================== */
function canMove(e,d){const c=Math.floor(e.x/TS),r=Math.floor(e.y/TS);return !isWall(r+d.y,c+d.x)}
function step(e,dt){
  const c=Math.floor(e.x/TS),r=Math.floor(e.y/TS);
  const ccx=(c+.5)*TS,ccy=(r+.5)*TS;
  const al=Math.abs(e.x-ccx)<3&&Math.abs(e.y-ccy)<3;
  if(al&&e.next&&canMove(e,e.next)){e.x=ccx;e.y=ccy;e.dir=e.next;e.next=null}
  if(al&&!canMove(e,e.dir)){e.x=ccx;e.y=ccy;return}
  e.x+=e.dir.x*e.speed*dt;e.y+=e.dir.y*e.speed*dt;
  e.x=Math.max(TS*.5,Math.min(cv.width-TS*.5,e.x));
  e.y=Math.max(TS*.5,Math.min(cv.height-TS*.5,e.y));
}
function ghostAI(g,dt){
  const c=Math.floor(g.x/TS),r=Math.floor(g.y/TS),key=r+','+c;
  const ccx=(c+.5)*TS,ccy=(r+.5)*TS;
  if(Math.abs(g.x-ccx)<3&&Math.abs(g.y-ccy)<3&&g.lastTile!==key){
    g.lastTile=key;g.x=ccx;g.y=ccy;
    const opts=Object.values(DIRS).filter(d=>!isWall(r+d.y,c+d.x)&&!(d.x===-g.dir.x&&d.y===-g.dir.y));
    const list=opts.length?opts:Object.values(DIRS).filter(d=>!isWall(r+d.y,c+d.x));
    if(list.length){
      const pr=Math.floor(G.player.y/TS),pc=Math.floor(G.player.x/TS);
      if(Math.random()<.22)g.dir=rnd(list);
      else{let best=list[0],bd=G.fright>0?-1e9:1e9;
        for(const d of list){const dd=Math.hypot(r+d.y-pr,c+d.x-pc);
          if(G.fright>0?dd>bd:dd<bd){bd=dd;best=d}}
        g.dir=best}
    }
  }
  const old=g.speed;g.speed=g.speed*(G.fright>0?.58:1);step(g,dt);g.speed=old;
}
let lastT=0;
function loop(t){
  if(!G.playing)return;
  const dt=Math.min(.045,(t-lastT)/1000);lastT=t;
  if(G.state==='play'){
    step(G.player,dt);
    G.player.mouth=(G.player.mouth+dt*11)%(Math.PI*1.1);
    if(G.player.inv>0)G.player.inv-=dt;
    if(G.fright>0)G.fright-=dt;
    const pr=Math.floor(G.player.y/TS),pc=Math.floor(G.player.x/TS);
    if(G.pellets[pr]&&G.pellets[pr][pc]){G.pellets[pr][pc]=false;G.score+=5;SFX.chomp();updHUD()}
    const pi=G.power.findIndex(p=>p[0]===pr&&p[1]===pc);
    if(pi>=0){G.power.splice(pi,1);G.fright=7;G.score+=30;SFX.power();updHUD()}
    const oi=G.orbs.findIndex(o=>o.r===pr&&o.c===pc);
    if(oi>=0){
      const orb=G.orbs.splice(oi,1)[0];G.orbGot++;SFX.orb();updHUD();
      askQuestion(orb.type,false);return requestAnimationFrame(loop);
    }
    G.ghosts.forEach(g=>ghostAI(g,dt));
    for(const g of G.ghosts){
      if(Math.hypot(g.x-G.player.x,g.y-G.player.y)<TS*.72){
        if(G.fright>0){const cell=rnd(openCells());g.x=(cell[1]+.5)*TS;g.y=(cell[0]+.5)*TS;
          G.score+=120;SFX.eatghost();updHUD()}
        else if(G.player.inv<=0){loseLife();break}
      }
    }
  }
  draw();requestAnimationFrame(loop);
}
function loseLife(){
  G.lives--;SFX.die();buzz(180);updHUD();saveGame(true);netPush(true);
  if(G.lives<=0){endGame(false);return}
  banner('💥 ระวังผีนะ!<br><span style="font-size:.6em">เหลือ '+G.lives+' ชีวิต</span>',1400);
  const cells=openCells();
  const s=cells.reduce((b,x)=>((ROWS-x[0])+x[1]<(ROWS-b[0])+b[1]?x:b),cells[0]);
  G.player.x=(s[1]+.5)*TS;G.player.y=(s[0]+.5)*TS;G.player.dir=DIRS.R;G.player.next=null;G.player.inv=2.4;
  const gs=spreadCells(cells.filter(c=>dist(c,s)>4),G.ghosts.length,3);
  G.ghosts.forEach((g,i)=>{const c=gs[i]||rnd(cells);g.x=(c[1]+.5)*TS;g.y=(c[0]+.5)*TS;g.lastTile=''});
}
function draw(){
  const T=THEMES[G.level-1];
  cx.fillStyle=T.bg;cx.fillRect(0,0,cv.width,cv.height);
  for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++){
    if(G.maze[r][c]===1){
      const x=c*TS,y=r*TS;
      const gr=cx.createLinearGradient(x,y,x,y+TS);
      gr.addColorStop(0,T.wall);gr.addColorStop(1,T.wall2);
      cx.fillStyle=gr;cx.beginPath();
      if(cx.roundRect)cx.roundRect(x+1.5,y+1.5,TS-3,TS-3,6);else cx.rect(x+1.5,y+1.5,TS-3,TS-3);
      cx.fill();
    }else if(G.pellets[r][c]){
      cx.fillStyle=T.dot;cx.beginPath();cx.arc(c*TS+TS/2,r*TS+TS/2,2.6,0,7);cx.fill();
    }
  }
  const pulse=1+Math.sin(Date.now()/180)*.22;
  cx.textAlign='center';cx.textBaseline='middle';
  G.power.forEach(([r,c])=>{cx.font=(15*pulse)+'px serif';cx.fillText('⭐',c*TS+TS/2,r*TS+TS/2)});
  G.orbs.forEach(o=>{
    cx.save();cx.shadowColor='#ffd93d';cx.shadowBlur=15;
    cx.beginPath();cx.fillStyle='rgba(255,217,61,.18)';cx.arc(o.c*TS+TS/2,o.r*TS+TS/2,TS*.46*pulse,0,7);cx.fill();
    cx.font=(17*pulse)+'px serif';cx.fillText(SKILL_EM[SKILL[o.type]],o.c*TS+TS/2,o.r*TS+TS/2);
    cx.restore();
  });
  G.ghosts.forEach(g=>{
    const fr=G.fright>0;const col=fr?((G.fright<2&&Math.floor(Date.now()/180)%2)?'#fff':'#3b5bdb'):g.color;
    const x=g.x,y=g.y,R=TS*.42;
    cx.fillStyle=col;cx.beginPath();
    cx.arc(x,y-2,R,Math.PI,0);cx.lineTo(x+R,y+R-2);
    for(let i=0;i<3;i++){cx.lineTo(x+R-(R*2/3)*(i+.5),y+R-6);cx.lineTo(x+R-(R*2/3)*(i+1),y+R-2)}
    cx.closePath();cx.fill();
    cx.fillStyle='#fff';cx.beginPath();cx.arc(x-5,y-4,3.4,0,7);cx.arc(x+5,y-4,3.4,0,7);cx.fill();
    cx.fillStyle=fr?'#fff':'#123';cx.beginPath();
    cx.arc(x-5+g.dir.x*1.6,y-4+g.dir.y*1.6,1.7,0,7);cx.arc(x+5+g.dir.x*1.6,y-4+g.dir.y*1.6,1.7,0,7);cx.fill();
  });
  const p=G.player,ang=Math.abs(Math.sin(p.mouth))*.72,base=Math.atan2(p.dir.y,p.dir.x);
  if(!(p.inv>0&&Math.floor(Date.now()/110)%2)){
    cx.save();cx.shadowColor='#ffd93d';cx.shadowBlur=16;
    cx.fillStyle='#ffd93d';cx.beginPath();
    cx.moveTo(p.x,p.y);cx.arc(p.x,p.y,TS*.44,base+ang,base-ang);cx.closePath();cx.fill();cx.restore();
  }
  if(G.fright>0){cx.fillStyle='rgba(255,255,255,.85)';cx.font='bold 13px sans-serif';cx.textAlign='left';
    cx.fillText('POWER '+G.fright.toFixed(1)+'s',8,14)}
}
